# Astra thin-layer build — base on the existing VNC-capable image to skip the
# GFW-hostile apt / npm / Camoufox downloads entirely.
#
# Why: the canonical Dockerfile (upstream v1.13.1) does `RUN apt-get install`
# (109 deb packages) + `RUN npm ci` (needs node-gyp for better-sqlite3) + curl
# downloads. Rootless podman behind the GFW stalls on deb.debian.org big-file
# downloads and registry.npmjs.org. This thin layer reuses the already-built
# `135.0.1-x86_64-vnc` image (which has x11vnc, websockify, the Camoufox
# 135.0.1 binary, and a working toolchain) and only overlays the NEW code.
#
# Trade-off: image tag is a layer on an unreproducible base — not a standalone
# build. Use the canonical Dockerfile when a network-clean build machine exists.
FROM localhost/camofox-browser:135.0.1-x86_64-vnc

# Overlay the merged v1.13.1 + astra-fork code.
# node_modules is host-preinstalled (has all prod + dev deps incl. the prebuilt
# better-sqlite3 binary) so we skip container `npm ci` entirely.
COPY package.json package-lock.json ./
COPY node_modules ./node_modules
COPY server.js ./
COPY camofox.config.json ./
COPY lib/ ./lib/
COPY plugins/ ./plugins/
COPY scripts/ ./scripts/

# Astra fork runtime env (baked mirror of the upstream Dockerfile values).
ENV NODE_ENV=production
ENV CAMOFOX_PORT=9377
ENV ENABLE_VNC=1
ENV BROWSER_IDLE_TIMEOUT_MS=0

EXPOSE 9377
EXPOSE 5900

CMD ["sh", "-c", "node --max-old-space-size=${MAX_OLD_SPACE_SIZE:-128} server.js"]
