# Thin override layer — based on existing VNC image
FROM localhost/camofox-browser:135.0.1-x86_64-vnc

# Copy patched vnc-watcher.sh (v2.3: fallback Xvfb :99 + port-based liveness
# + ps|awk self-exclusion + display-aware attach — VNC always reachable AND
# serves the browser's actual display, survives zombie states + port theft)
COPY plugins/vnc/vnc-watcher.sh /app/plugins/vnc/vnc-watcher.sh

# Override CMD: remove xvfb-run (VNC plugin manages its own display)
# exec: PID 1 = node so SIGTERM reaches gracefulShutdown (podman stop 0.8s,
# not 15s+SIGKILL). VNC watcher spawns x11vnc itself; no background x11vnc here.
ENV ENABLE_VNC=1
ENV BROWSER_IDLE_TIMEOUT_MS=0

EXPOSE 5900

CMD ["sh", "-c", "exec node --max-old-space-size=${MAX_OLD_SPACE_SIZE:-128} server.js"]
